  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="64" posY="48">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_1" show="false"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="// Lot de chargement : date du jour si non renseigne&#xA;if (context.date_lot == null || context.date_lot.trim().isEmpty()) {&#xA;    context.date_lot = TalendDate.formatDate(&quot;yyyy-MM-dd&quot;, TalendDate.getCurrentDate());&#xA;}&#xA;if (context.sel_hash == null || context.sel_hash.trim().length() &lt; 8) {&#xA;    throw new RuntimeException(&quot;context.sel_hash doit etre renseigne (8 caracteres minimum) : pseudonymisation RGPD&quot;);&#xA;}&#xA;System.out.println(&quot;[J6_Hospitalisations] lot &quot; + context.date_lot);"/>
    <elementParameter field="TEXT" name="LABEL" value="Initialisation du lot"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tHDFSPut" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="64" posY="160">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHDFSPut_1" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="false"/>
    <elementParameter field="CLOSED_LIST" name="DISTRIBUTION" value="CLOUDERA"/>
    <elementParameter field="CLOSED_LIST" name="DB_VERSION" value="Cloudera_CDH5_13_0"/>
    <elementParameter field="CLOSED_LIST" name="SCHEME" value="HDFS"/>
    <elementParameter field="CLOSED_LIST" name="AUTHENTICATION_MODE" value="USERNAME"/>
    <elementParameter field="TEXT" name="FS_DEFAULT_NAME" value="context.hdfs_uri"/>
    <elementParameter field="TEXT" name="USERNAME" value="context.hdfs_user"/>
    <elementParameter field="CHECK" name="USE_DATANODE_HOSTNAME" value="true"/>
    <elementParameter field="DIRECTORY" name="LOCALDIR" value="context.data_dir + &quot;/Hospitalisation&quot;"/>
    <elementParameter field="DIRECTORY_HADOOP" name="REMOTEDIR" value="&quot;/datalake/bronze/hospitalisations/date_ingestion=&quot; + context.date_lot"/>
    <elementParameter field="CLOSED_LIST" name="OVERWRITE" value="true"/>
    <elementParameter field="TABLE" name="FILES">
      <elementValue elementRef="FILEMASK" value="&quot;Hospitalisations.csv&quot;"/>
      <elementValue elementRef="NEWNAME" value="&quot;&quot;"/>
    </elementParameter>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="Hospitalisations.csv"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tHiveConnection" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="272">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHiveConnection_1" show="false"/>
    <elementParameter field="TECHNICAL" name="PROPERTY:PROPERTY_TYPE" value="BUILT_IN"/>
    <elementParameter field="CLOSED_LIST" name="DISTRIBUTION" value="CLOUDERA"/>
    <elementParameter field="CLOSED_LIST" name="HIVE_VERSION" value="Cloudera_CDH5_13_0"/>
    <elementParameter field="CLOSED_LIST" name="CONNECTION_MODE" value="STANDALONE"/>
    <elementParameter field="CLOSED_LIST" name="HIVE_SERVER" value="HIVE2"/>
    <elementParameter field="TEXT" name="HOST" value="context.hive_host"/>
    <elementParameter field="TEXT" name="PORT" value="context.hive_port"/>
    <elementParameter field="TEXT" name="DBNAME" value="&quot;default&quot;"/>
    <elementParameter field="TEXT" name="USER" value="context.hive_user"/>
    <elementParameter field="TEXT" name="HIVE_ADDITIONAL_JDBC" value="&quot;?hive.exec.dynamic.partition=true;hive.exec.dynamic.partition.mode=nonstrict;hive.auto.convert.join=false;mapreduce.map.memory.mb=1024;mapreduce.map.java.opts=-Xmx820m;mapreduce.reduce.memory.mb=1024;mapreduce.reduce.java.opts=-Xmx820m&quot;"/>
    <elementParameter field="CHECK" name="USE_YARN" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="Connexion Hive (HiveServer2)"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tHiveRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="384">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHiveRow_1" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tHiveConnection_1"/>
    <elementParameter field="CLOSED_LIST" name="DISTRIBUTION" value="CLOUDERA"/>
    <elementParameter field="CLOSED_LIST" name="HIVE_VERSION" value="Cloudera_CDH5_13_0"/>
    <elementParameter field="TECHNICAL" name="SCHEMA_FLOW:SCHEMA_TYPE" value="BUILT_IN"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;ALTER TABLE bronze.hospitalisation ADD IF NOT EXISTS PARTITION (date_ingestion = '&quot; + context.date_lot + &quot;') &quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="Lot du jour bronze.hospitalisation"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tHiveRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="496">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHiveRow_2" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tHiveConnection_1"/>
    <elementParameter field="CLOSED_LIST" name="DISTRIBUTION" value="CLOUDERA"/>
    <elementParameter field="CLOSED_LIST" name="HIVE_VERSION" value="Cloudera_CDH5_13_0"/>
    <elementParameter field="TECHNICAL" name="SCHEMA_FLOW:SCHEMA_TYPE" value="BUILT_IN"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT OVERWRITE TABLE silver.hospitalisation PARTITION (annee) &quot; +&#xA;&quot;SELECT h.num_hospitalisation, pa.id_patient_hash, h.etablissement_code, h.code_diag, h.date_entree, h.duree_jours, &quot; +&#xA;&quot;       pa.sexe, year(h.date_entree) - year(pa.date_naissance), year(h.date_entree) AS annee &quot; +&#xA;&quot;FROM silver.v_j6_hospitalisation h &quot; +&#xA;&quot;JOIN silver.patient pa ON pa.id_patient_hash = sha2(concat('&quot; + context.sel_hash + &quot;', h.id_patient), 256) &quot; +&#xA;&quot;WHERE h.date_ingestion = '&quot; + context.date_lot + &quot;' AND h.num_hospitalisation IS NOT NULL AND h.date_entree IS NOT NULL &quot; +&#xA;&quot;  AND h.duree_jours BETWEEN 1 AND 365 AND h.rang = 1 &quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="Chargement silver.hospitalisation"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tHiveRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="608">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHiveRow_3" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tHiveConnection_1"/>
    <elementParameter field="CLOSED_LIST" name="DISTRIBUTION" value="CLOUDERA"/>
    <elementParameter field="CLOSED_LIST" name="HIVE_VERSION" value="Cloudera_CDH5_13_0"/>
    <elementParameter field="TECHNICAL" name="SCHEMA_FLOW:SCHEMA_TYPE" value="BUILT_IN"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT OVERWRITE TABLE silver.rejets PARTITION (job = 'J6_Hospitalisations', date_lot = '&quot; + context.date_lot + &quot;') &quot; +&#xA;&quot;SELECT 'Hospitalisations.csv', coalesce(CAST(h.num_hospitalisation AS STRING), ''), &quot; +&#xA;&quot;       CASE WHEN h.num_hospitalisation IS NULL THEN 'numero absent' &quot; +&#xA;&quot;            WHEN h.date_entree IS NULL THEN 'date d entree invalide' &quot; +&#xA;&quot;            WHEN h.duree_jours IS NULL OR h.duree_jours NOT BETWEEN 1 AND 365 THEN 'duree invalide' &quot; +&#xA;&quot;            WHEN h.rang &gt; 1 THEN 'doublon num_hospitalisation' &quot; +&#xA;&quot;            ELSE 'patient inconnu' END, &quot; +&#xA;&quot;       concat_ws('|', coalesce(h.date_entree, ''), coalesce(h.code_diag, ''), coalesce(h.etablissement_code, '')) &quot; +&#xA;&quot;FROM silver.v_j6_hospitalisation h &quot; +&#xA;&quot;LEFT JOIN silver.patient pa ON pa.id_patient_hash = sha2(concat('&quot; + context.sel_hash + &quot;', h.id_patient), 256) &quot; +&#xA;&quot;WHERE h.date_ingestion = '&quot; + context.date_lot + &quot;' &quot; +&#xA;&quot;  AND (h.num_hospitalisation IS NULL OR h.date_entree IS NULL OR h.duree_jours IS NULL &quot; +&#xA;&quot;       OR h.duree_jours NOT BETWEEN 1 AND 365 OR h.rang &gt; 1 OR pa.id_patient_hash IS NULL) &quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="Rejets silver.rejets"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tHiveRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="720">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHiveRow_4" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tHiveConnection_1"/>
    <elementParameter field="CLOSED_LIST" name="DISTRIBUTION" value="CLOUDERA"/>
    <elementParameter field="CLOSED_LIST" name="HIVE_VERSION" value="Cloudera_CDH5_13_0"/>
    <elementParameter field="TECHNICAL" name="SCHEMA_FLOW:SCHEMA_TYPE" value="BUILT_IN"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT OVERWRITE TABLE gold.fait_hospitalisation_globale PARTITION (annee) &quot; +&#xA;&quot;SELECT CAST(regexp_replace(date_entree, '-', '') AS BIGINT), CAST(count(*) AS INT), CAST(sum(duree_jours) AS INT), &quot; +&#xA;&quot;       avg(duree_jours), annee &quot; +&#xA;&quot;FROM silver.hospitalisation &quot; +&#xA;&quot;GROUP BY date_entree, annee &quot; +&#xA;&quot;DISTRIBUTE BY annee &quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="Chargement gold.fait_hospitalisation_globale"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tHiveRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="832">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHiveRow_5" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tHiveConnection_1"/>
    <elementParameter field="CLOSED_LIST" name="DISTRIBUTION" value="CLOUDERA"/>
    <elementParameter field="CLOSED_LIST" name="HIVE_VERSION" value="Cloudera_CDH5_13_0"/>
    <elementParameter field="TECHNICAL" name="SCHEMA_FLOW:SCHEMA_TYPE" value="BUILT_IN"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT OVERWRITE TABLE gold.fait_hospitalisation_diagnostic PARTITION (annee) &quot; +&#xA;&quot;SELECT coalesce(d.id, -1), CAST(regexp_replace(h.date_entree, '-', '') AS BIGINT), CAST(count(*) AS INT), &quot; +&#xA;&quot;       CAST(sum(h.duree_jours) AS INT), h.annee &quot; +&#xA;&quot;FROM silver.hospitalisation h &quot; +&#xA;&quot;LEFT JOIN gold.dim_diagnostic d ON d.code = h.code_diag &quot; +&#xA;&quot;GROUP BY coalesce(d.id, -1), h.date_entree, h.annee &quot; +&#xA;&quot;DISTRIBUTE BY annee &quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="Chargement gold.fait_hospitalisation_diagnostic"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tHiveRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="944">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHiveRow_6" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tHiveConnection_1"/>
    <elementParameter field="CLOSED_LIST" name="DISTRIBUTION" value="CLOUDERA"/>
    <elementParameter field="CLOSED_LIST" name="HIVE_VERSION" value="Cloudera_CDH5_13_0"/>
    <elementParameter field="TECHNICAL" name="SCHEMA_FLOW:SCHEMA_TYPE" value="BUILT_IN"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT OVERWRITE TABLE gold.fait_hospitalisation_patient PARTITION (annee) &quot; +&#xA;&quot;SELECT CASE WHEN h.age BETWEEN 0 AND 120 THEN (CASE h.sexe WHEN 'M' THEN 1000 WHEN 'F' THEN 2000 ELSE 3000 END) + h.age ELSE -1 END, &quot; +&#xA;&quot;       CAST(regexp_replace(h.date_entree, '-', '') AS BIGINT), CAST(count(*) AS INT), CAST(sum(h.duree_jours) AS INT), h.annee &quot; +&#xA;&quot;FROM silver.hospitalisation h &quot; +&#xA;&quot;GROUP BY CASE WHEN h.age BETWEEN 0 AND 120 THEN (CASE h.sexe WHEN 'M' THEN 1000 WHEN 'F' THEN 2000 ELSE 3000 END) + h.age ELSE -1 END, &quot; +&#xA;&quot;         h.date_entree, h.annee &quot; +&#xA;&quot;DISTRIBUTE BY annee &quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="Chargement gold.fait_hospitalisation_patient"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tHiveRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="1056">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHiveRow_7" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>

  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="64" posY="48">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_1" show="false"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="// Lot de chargement : date du jour si non renseigne&#xA;if (context.date_lot == null || context.date_lot.trim().isEmpty()) {&#xA;    context.date_lot = TalendDate.formatDate(&quot;yyyy-MM-dd&quot;, TalendDate.getCurrentDate());&#xA;}&#xA;System.out.println(&quot;[J0_Temps] lot &quot; + context.date_lot);"/>
    <elementParameter field="TEXT" name="LABEL" value="Initialisation du lot"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tRowGenerator" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="160">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tRowGenerator_1" show="false"/>
    <elementParameter field="TEXT" name="NB_ROWS" value="3652"/>
    <elementParameter field="TABLE" name="VALUES">
      <elementValue elementRef="SCHEMA_COLUMN" value="n"/>
      <elementValue elementRef="ARRAY" value="Numeric.sequence(&quot;s1&quot;, 0, 1)"/>
    </elementParameter>
    <elementParameter field="TEXT" name="LABEL" value="3652 jours (2014-2023)"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tRowGenerator_1">
      <column comment="" defaultValue="" key="false" length="-1" name="n" nullable="true" pattern="" precision="-1" sourceType="" type="id_Integer" originalLength="-1" usefulColumn="true"/>
    </metadata>
  </node>
  <node componentName="tMap" componentVersion="2.1" offsetLabelX="0" offsetLabelY="0" posX="320" posY="160">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMap_1" show="false"/>
    <elementParameter field="CLOSED_LIST" name="LINK_STYLE" value="AUTO"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="Calcul des attributs du jour"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" label="temps" name="temps">
      <column comment="" defaultValue="" key="false" length="-1" name="id" nullable="true" pattern="" precision="-1" sourceType="" type="id_Long" originalLength="-1" usefulColumn="true"/>
      <column comment="" defaultValue="" key="false" length="-1" name="date_jour" nullable="true" pattern="" precision="-1" sourceType="" type="id_String" originalLength="-1" usefulColumn="true"/>
      <column comment="" defaultValue="" key="false" length="-1" name="jour_semaine" nullable="true" pattern="" precision="-1" sourceType="" type="id_Integer" originalLength="-1" usefulColumn="true"/>
      <column comment="" defaultValue="" key="false" length="-1" name="jour" nullable="true" pattern="" precision="-1" sourceType="" type="id_Integer" originalLength="-1" usefulColumn="true"/>
      <column comment="" defaultValue="" key="false" length="-1" name="semaine" nullable="true" pattern="" precision="-1" sourceType="" type="id_Integer" originalLength="-1" usefulColumn="true"/>
      <column comment="" defaultValue="" key="false" length="-1" name="mois" nullable="true" pattern="" precision="-1" sourceType="" type="id_Integer" originalLength="-1" usefulColumn="true"/>
      <column comment="" defaultValue="" key="false" length="-1" name="trimestre" nullable="true" pattern="" precision="-1" sourceType="" type="id_Integer" originalLength="-1" usefulColumn="true"/>
      <column comment="" defaultValue="" key="false" length="-1" name="semestre" nullable="true" pattern="" precision="-1" sourceType="" type="id_Integer" originalLength="-1" usefulColumn="true"/>
      <column comment="" defaultValue="" key="false" length="-1" name="annee" nullable="true" pattern="" precision="-1" sourceType="" type="id_Integer" originalLength="-1" usefulColumn="true"/>
    </metadata>
    <nodeData xsi:type="TalendMapper:MapperData">
      <uiProperties shellMaximized="true"/>
      <varTables sizeState="INTERMEDIATE" name="Var">
        <mapperTableEntries name="d" expression="TalendDate.addDate(TalendDate.parseDate(&quot;yyyy-MM-dd&quot;, &quot;2014-01-01&quot;), row1.n, &quot;dd&quot;)" type="id_Date" nullable="true"/>
      </varTables>
      <outputTables sizeState="INTERMEDIATE" name="temps">
        <mapperTableEntries name="id" expression="Long.parseLong(TalendDate.formatDate(&quot;yyyyMMdd&quot;, Var.d))" type="id_Long" nullable="true"/>
        <mapperTableEntries name="date_jour" expression="TalendDate.formatDate(&quot;yyyy-MM-dd&quot;, Var.d)" type="id_String" nullable="true"/>
        <mapperTableEntries name="jour_semaine" expression="(TalendDate.getPartOfDate(&quot;DAY_OF_WEEK&quot;, Var.d) + 5) % 7 + 1" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="jour" expression="TalendDate.getPartOfDate(&quot;DAY_OF_MONTH&quot;, Var.d)" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="semaine" expression="TalendDate.getPartOfDate(&quot;WEEK_OF_YEAR&quot;, Var.d)" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="mois" expression="TalendDate.getPartOfDate(&quot;MONTH&quot;, Var.d) + 1" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="trimestre" expression="TalendDate.getPartOfDate(&quot;MONTH&quot;, Var.d) / 3 + 1" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="semestre" expression="TalendDate.getPartOfDate(&quot;MONTH&quot;, Var.d) &lt; 6 ? 1 : 2" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="annee" expression="TalendDate.getPartOfDate(&quot;YEAR&quot;, Var.d)" type="id_Integer" nullable="true"/>
      </outputTables>
      <inputTables sizeState="INTERMEDIATE" name="row1" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
        <mapperTableEntries name="n" type="id_Integer" nullable="true"/>
      </inputTables>
    </nodeData>
  </node>

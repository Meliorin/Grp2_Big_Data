    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tHiveRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="720">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHiveRow_3" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tHiveConnection_1"/>
    <elementParameter field="CLOSED_LIST" name="DISTRIBUTION" value="CLOUDERA"/>
    <elementParameter field="CLOSED_LIST" name="HIVE_VERSION" value="Cloudera_CDH5_13_0"/>
    <elementParameter field="TECHNICAL" name="SCHEMA_FLOW:SCHEMA_TYPE" value="BUILT_IN"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT OVERWRITE TABLE silver.satisfaction PARTITION (annee) &quot; +&#xA;&quot;SELECT identifiant_organisation, finess_juridique, type_score, score, nb_reponses, annee &quot; +&#xA;&quot;FROM silver.v_j8_satisfaction &quot; +&#xA;&quot;WHERE date_ingestion = '&quot; + context.date_lot + &quot;' &quot; +&#xA;&quot;  AND score IS NOT NULL AND score BETWEEN 0 AND 100 AND nb_reponses IS NOT NULL AND nb_reponses &gt; 0 &quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="Chargement silver.satisfaction"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tHiveRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="832">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHiveRow_4" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tHiveConnection_1"/>
    <elementParameter field="CLOSED_LIST" name="DISTRIBUTION" value="CLOUDERA"/>
    <elementParameter field="CLOSED_LIST" name="HIVE_VERSION" value="Cloudera_CDH5_13_0"/>
    <elementParameter field="TECHNICAL" name="SCHEMA_FLOW:SCHEMA_TYPE" value="BUILT_IN"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT OVERWRITE TABLE silver.rejets PARTITION (job = 'J8_Satisfaction', date_lot = '&quot; + context.date_lot + &quot;') &quot; +&#xA;&quot;SELECT concat('esatis_', CAST(annee AS STRING)), concat(identifiant_organisation, '/', type_score), &quot; +&#xA;&quot;       CASE WHEN score IS NULL THEN 'non calculable (classe DI)' &quot; +&#xA;&quot;            WHEN score NOT BETWEEN 0 AND 100 THEN 'score hors bornes' &quot; +&#xA;&quot;            ELSE 'non ponderable (nb de reponses absent)' END, &quot; +&#xA;&quot;       concat_ws('|', CAST(annee AS STRING), coalesce(CAST(score AS STRING), ''), coalesce(CAST(nb_reponses AS STRING), '')) &quot; +&#xA;&quot;FROM silver.v_j8_satisfaction &quot; +&#xA;&quot;WHERE date_ingestion = '&quot; + context.date_lot + &quot;' &quot; +&#xA;&quot;  AND (score IS NULL OR score NOT BETWEEN 0 AND 100 OR nb_reponses IS NULL OR nb_reponses &lt;= 0) &quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="Rejets silver.rejets"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tHiveRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="944">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHiveRow_5" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tHiveConnection_1"/>
    <elementParameter field="CLOSED_LIST" name="DISTRIBUTION" value="CLOUDERA"/>
    <elementParameter field="CLOSED_LIST" name="HIVE_VERSION" value="Cloudera_CDH5_13_0"/>
    <elementParameter field="TECHNICAL" name="SCHEMA_FLOW:SCHEMA_TYPE" value="BUILT_IN"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT OVERWRITE TABLE gold.fait_satisfaction PARTITION (annee) &quot; +&#xA;&quot;SELECT coalesce(e.localisation_id, -1), t.id, CAST(concat(CAST(s.annee AS STRING), '0101') AS BIGINT), &quot; +&#xA;&quot;       sum(s.score * s.nb_reponses) / sum(s.nb_reponses), CAST(sum(s.nb_reponses) AS INT), s.annee &quot; +&#xA;&quot;FROM silver.satisfaction s &quot; +&#xA;&quot;JOIN gold.dim_type_satisfaction t ON t.code = s.type_score &quot; +&#xA;&quot;LEFT JOIN gold.dim_etablissement e ON e.code = s.identifiant_organisation &quot; +&#xA;&quot;GROUP BY coalesce(e.localisation_id, -1), t.id, s.annee &quot; +&#xA;&quot;DISTRIBUTE BY annee &quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="Chargement gold.fait_satisfaction"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tHiveRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="1056">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHiveRow_6" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tHiveConnection_1"/>
    <elementParameter field="CLOSED_LIST" name="DISTRIBUTION" value="CLOUDERA"/>
    <elementParameter field="CLOSED_LIST" name="HIVE_VERSION" value="Cloudera_CDH5_13_0"/>
    <elementParameter field="TECHNICAL" name="SCHEMA_FLOW:SCHEMA_TYPE" value="BUILT_IN"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT INTO TABLE audit.journal_chargements &quot; +&#xA;&quot;SELECT 'J8_Satisfaction', '&quot; + context.date_lot + &quot;', from_unixtime(unix_timestamp()), sum(b), sum(s), sum(r), sum(g), 'OK' &quot; +&#xA;&quot;FROM ( &quot; +&#xA;&quot;  SELECT CAST(n AS BIGINT) AS b, CAST(0 AS BIGINT) AS s, CAST(0 AS BIGINT) AS r, CAST(0 AS BIGINT) AS g FROM (SELECT count(*) AS n FROM (SELECT finess FROM bronze.esatis_csv WHERE date_ingestion = '&quot; + context.date_lot + &quot;' UNION ALL SELECT finess FROM bronze.esatis_xlsx WHERE date_ingestion = '&quot; + context.date_lot + &quot;') x) b0 &quot; +&#xA;&quot;  UNION ALL &quot; +&#xA;&quot;  SELECT CAST(0 AS BIGINT) AS b, CAST(n AS BIGINT) AS s, CAST(0 AS BIGINT) AS r, CAST(0 AS BIGINT) AS g FROM (SELECT count(*) AS n FROM silver.satisfaction) s0 &quot; +&#xA;&quot;  UNION ALL &quot; +&#xA;&quot;  SELECT CAST(0 AS BIGINT) AS b, CAST(0 AS BIGINT) AS s, CAST(n AS BIGINT) AS r, CAST(0 AS BIGINT) AS g FROM (SELECT count(*) AS n FROM silver.rejets WHERE job = 'J8_Satisfaction' AND date_lot = '&quot; + context.date_lot + &quot;') r0 &quot; +&#xA;&quot;  UNION ALL &quot; +&#xA;&quot;  SELECT CAST(0 AS BIGINT) AS b, CAST(0 AS BIGINT) AS s, CAST(0 AS BIGINT) AS r, CAST(n AS BIGINT) AS g FROM (SELECT count(*) AS n FROM gold.fait_satisfaction) g0 &quot; +&#xA;&quot;) x &quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="Ajout audit.journal_chargements"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>

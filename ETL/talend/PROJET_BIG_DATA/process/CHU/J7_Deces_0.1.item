    <elementParameter field="CHECK" name="USE_DATANODE_HOSTNAME" value="true"/>
    <elementParameter field="DIRECTORY" name="LOCALDIR" value="context.data_dir + &quot;/DECES EN FRANCE&quot;"/>
    <elementParameter field="DIRECTORY_HADOOP" name="REMOTEDIR" value="&quot;/datalake/bronze/deces/date_ingestion=&quot; + context.date_lot"/>
    <elementParameter field="CLOSED_LIST" name="OVERWRITE" value="true"/>
    <elementParameter field="TABLE" name="FILES">
      <elementValue elementRef="FILEMASK" value="&quot;deces.csv&quot;"/>
      <elementValue elementRef="NEWNAME" value="&quot;&quot;"/>
    </elementParameter>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="deces.csv (1,9 Go)"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tHiveConnection" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="272">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHiveConnection_1" show="false"/>

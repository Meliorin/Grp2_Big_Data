    <elementParameter field="TEXT" name="USER" value="context.hive_user"/>
    <elementParameter field="TEXT" name="HIVE_ADDITIONAL_JDBC" value="&quot;?hive.exec.dynamic.partition=true;hive.exec.dynamic.partition.mode=nonstrict;hive.auto.convert.join=false;mapreduce.map.memory.mb=1024;mapreduce.map.java.opts=-Xmx820m;mapreduce.reduce.memory.mb=1024;mapreduce.reduce.java.opts=-Xmx820m&quot;"/>

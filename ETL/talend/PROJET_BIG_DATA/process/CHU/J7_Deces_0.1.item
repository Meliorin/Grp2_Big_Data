  <node componentName="tHiveRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="384">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHiveRow_1" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tHiveConnection_1"/>
    <elementParameter field="CLOSED_LIST" name="DISTRIBUTION" value="CLOUDERA"/>
    <elementParameter field="CLOSED_LIST" name="HIVE_VERSION" value="Cloudera_CDH5_13_0"/>
    <elementParameter field="TECHNICAL" name="SCHEMA_FLOW:SCHEMA_TYPE" value="BUILT_IN"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;ALTER TABLE bronze.deces ADD IF NOT EXISTS PARTITION (date_ingestion = '&quot; + context.date_lot + &quot;') &quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="Lot du jour bronze.deces"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tHiveRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="496">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHiveRow_2" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tHiveConnection_1"/>
    <elementParameter field="CLOSED_LIST" name="DISTRIBUTION" value="CLOUDERA"/>
    <elementParameter field="CLOSED_LIST" name="HIVE_VERSION" value="Cloudera_CDH5_13_0"/>
    <elementParameter field="TECHNICAL" name="SCHEMA_FLOW:SCHEMA_TYPE" value="BUILT_IN"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT OVERWRITE TABLE silver.deces PARTITION (annee) &quot; +&#xA;&quot;SELECT CASE sexe WHEN '1' THEN 'M' WHEN '2' THEN 'F' ELSE 'I' END, &quot; +&#xA;&quot;       date_naissance, date_deces, code_lieu_deces, &quot; +&#xA;&quot;       CASE WHEN substr(code_lieu_deces, 1, 2) IN ('97', '98') THEN substr(code_lieu_deces, 1, 3) &quot; +&#xA;&quot;            ELSE substr(code_lieu_deces, 1, 2) END, &quot; +&#xA;&quot;       CASE WHEN substr(date_naissance, 1, 4) RLIKE '^[0-9]{4}$' &quot; +&#xA;&quot;            THEN year(date_deces) - CAST(substr(date_naissance, 1, 4) AS INT) END, &quot; +&#xA;&quot;       year(date_deces) AS annee &quot; +&#xA;&quot;FROM ( &quot; +&#xA;&quot;  SELECT d.*, row_number() OVER (PARTITION BY d.nom, d.prenom, d.date_naissance, d.date_deces, d.code_lieu_deces &quot; +&#xA;&quot;                                 ORDER BY d.numero_acte_deces) AS rang &quot; +&#xA;&quot;  FROM silver.v_j7_deces d &quot; +&#xA;&quot;  WHERE d.date_ingestion = '&quot; + context.date_lot + &quot;' AND d.annee_brute &gt;= 2014 &quot; +&#xA;&quot;) t &quot; +&#xA;&quot;WHERE date_deces IS NOT NULL &quot; +&#xA;&quot;  AND length(code_lieu_deces) = 5 AND code_lieu_deces NOT LIKE '99%' AND rang = 1 &quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="Chargement silver.deces"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tHiveRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="608">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHiveRow_3" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tHiveConnection_1"/>
    <elementParameter field="CLOSED_LIST" name="DISTRIBUTION" value="CLOUDERA"/>
    <elementParameter field="CLOSED_LIST" name="HIVE_VERSION" value="Cloudera_CDH5_13_0"/>
    <elementParameter field="TECHNICAL" name="SCHEMA_FLOW:SCHEMA_TYPE" value="BUILT_IN"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT OVERWRITE TABLE silver.rejets PARTITION (job = 'J7_Deces', date_lot = '&quot; + context.date_lot + &quot;') &quot; +&#xA;&quot;SELECT 'deces.csv', coalesce(numero_acte_deces, ''), &quot; +&#xA;&quot;       CASE WHEN date_deces IS NULL THEN 'date de deces invalide' &quot; +&#xA;&quot;            WHEN code_lieu_deces LIKE '99%' THEN 'deces a l etranger (pas de region)' &quot; +&#xA;&quot;            WHEN code_lieu_deces IS NULL OR length(code_lieu_deces) &lt;&gt; 5 THEN 'code lieu invalide' &quot; +&#xA;&quot;            ELSE 'doublon' END, &quot; +&#xA;&quot;       concat_ws('|', coalesce(date_deces, ''), coalesce(code_lieu_deces, '')) &quot; +&#xA;&quot;FROM ( &quot; +&#xA;&quot;  SELECT d.*, row_number() OVER (PARTITION BY d.nom, d.prenom, d.date_naissance, d.date_deces, d.code_lieu_deces &quot; +&#xA;&quot;                                 ORDER BY d.numero_acte_deces) AS rang &quot; +&#xA;&quot;  FROM silver.v_j7_deces d &quot; +&#xA;&quot;  WHERE d.date_ingestion = '&quot; + context.date_lot + &quot;' AND d.annee_brute &gt;= 2014 &quot; +&#xA;&quot;) t &quot; +&#xA;&quot;WHERE (date_deces IS NULL OR code_lieu_deces IS NULL OR length(code_lieu_deces) &lt;&gt; 5 &quot; +&#xA;&quot;       OR code_lieu_deces LIKE '99%' OR rang &gt; 1) &quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="Rejets silver.rejets"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tHiveRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="720">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHiveRow_4" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tHiveConnection_1"/>
    <elementParameter field="CLOSED_LIST" name="DISTRIBUTION" value="CLOUDERA"/>
    <elementParameter field="CLOSED_LIST" name="HIVE_VERSION" value="Cloudera_CDH5_13_0"/>
    <elementParameter field="TECHNICAL" name="SCHEMA_FLOW:SCHEMA_TYPE" value="BUILT_IN"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT OVERWRITE TABLE gold.fait_deces PARTITION (annee) &quot; +&#xA;&quot;SELECT coalesce(lc.id, ld.id, -1), CAST(regexp_replace(d.date_deces, '-', '') AS BIGINT), CAST(count(*) AS INT), d.annee &quot; +&#xA;&quot;FROM silver.deces d &quot; +&#xA;&quot;LEFT JOIN gold.dim_localisation lc ON lc.code_commune = d.code_lieu_deces &quot; +&#xA;&quot;LEFT JOIN gold.dim_localisation ld ON ld.code_commune = concat('D', d.code_departement) &quot; +&#xA;&quot;GROUP BY coalesce(lc.id, ld.id, -1), d.date_deces, d.annee &quot; +&#xA;&quot;DISTRIBUTE BY annee &quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="Chargement gold.fait_deces"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tHiveRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="832">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHiveRow_5" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tHiveConnection_1"/>
    <elementParameter field="CLOSED_LIST" name="DISTRIBUTION" value="CLOUDERA"/>
    <elementParameter field="CLOSED_LIST" name="HIVE_VERSION" value="Cloudera_CDH5_13_0"/>
    <elementParameter field="TECHNICAL" name="SCHEMA_FLOW:SCHEMA_TYPE" value="BUILT_IN"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT INTO TABLE audit.journal_chargements &quot; +&#xA;&quot;SELECT 'J7_Deces', '&quot; + context.date_lot + &quot;', from_unixtime(unix_timestamp()), sum(b), sum(s), sum(r), sum(g), 'OK' &quot; +&#xA;&quot;FROM ( &quot; +&#xA;&quot;  SELECT CAST(n AS BIGINT) AS b, CAST(0 AS BIGINT) AS s, CAST(0 AS BIGINT) AS r, CAST(0 AS BIGINT) AS g FROM (SELECT count(*) AS n FROM bronze.deces WHERE date_ingestion = '&quot; + context.date_lot + &quot;') b0 &quot; +&#xA;&quot;  UNION ALL &quot; +&#xA;&quot;  SELECT CAST(0 AS BIGINT) AS b, CAST(n AS BIGINT) AS s, CAST(0 AS BIGINT) AS r, CAST(0 AS BIGINT) AS g FROM (SELECT count(*) AS n FROM silver.deces) s0 &quot; +&#xA;&quot;  UNION ALL &quot; +&#xA;&quot;  SELECT CAST(0 AS BIGINT) AS b, CAST(0 AS BIGINT) AS s, CAST(n AS BIGINT) AS r, CAST(0 AS BIGINT) AS g FROM (SELECT count(*) AS n FROM silver.rejets WHERE job = 'J7_Deces' AND date_lot = '&quot; + context.date_lot + &quot;') r0 &quot; +&#xA;&quot;  UNION ALL &quot; +&#xA;&quot;  SELECT CAST(0 AS BIGINT) AS b, CAST(0 AS BIGINT) AS s, CAST(0 AS BIGINT) AS r, CAST(n AS BIGINT) AS g FROM (SELECT sum(nombre) AS n FROM gold.fait_deces) g0 &quot; +&#xA;&quot;) x &quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="Ajout audit.journal_chargements"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>

  <node componentName="tHiveRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="944">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHiveRow_4" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tHiveConnection_1"/>
    <elementParameter field="CLOSED_LIST" name="DISTRIBUTION" value="CLOUDERA"/>
    <elementParameter field="CLOSED_LIST" name="HIVE_VERSION" value="Cloudera_CDH5_13_0"/>
    <elementParameter field="TECHNICAL" name="SCHEMA_FLOW:SCHEMA_TYPE" value="BUILT_IN"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT OVERWRITE TABLE silver.professionnel &quot; +&#xA;&quot;SELECT p.identifiant, p.type_identifiant, p.categorie_professionnelle, p.profession, p.code_specialite, &quot; +&#xA;&quot;       coalesce(trim(s.specialite), 'Inconnu'), r.etablissement_code &quot; +&#xA;&quot;FROM silver.v_j2_professionnel p &quot; +&#xA;&quot;LEFT JOIN (SELECT code_specialite, max(specialite) AS specialite FROM bronze.specialites &quot; +&#xA;&quot;           WHERE date_ingestion = '&quot; + context.date_lot + &quot;' GROUP BY code_specialite) s ON s.code_specialite = p.code_specialite &quot; +&#xA;&quot;LEFT JOIN (SELECT identifiant, etablissement_code FROM silver.v_j2_rattachement &quot; +&#xA;&quot;           WHERE date_ingestion = '&quot; + context.date_lot + &quot;') r ON r.identifiant = p.identifiant &quot; +&#xA;&quot;WHERE p.date_ingestion = '&quot; + context.date_lot + &quot;' AND p.identifiant IS NOT NULL AND p.rang = 1 &quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="Chargement silver.professionnel"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tHiveRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="1056">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHiveRow_5" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tHiveConnection_1"/>
    <elementParameter field="CLOSED_LIST" name="DISTRIBUTION" value="CLOUDERA"/>
    <elementParameter field="CLOSED_LIST" name="HIVE_VERSION" value="Cloudera_CDH5_13_0"/>
    <elementParameter field="TECHNICAL" name="SCHEMA_FLOW:SCHEMA_TYPE" value="BUILT_IN"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT OVERWRITE TABLE silver.rejets PARTITION (job = 'J2_Professionnels', date_lot = '&quot; + context.date_lot + &quot;') &quot; +&#xA;&quot;SELECT 'Professionnel_de_sante', coalesce(identifiant, ''), &quot; +&#xA;&quot;       CASE WHEN identifiant IS NULL THEN 'identifiant absent' ELSE 'doublon identifiant' END, &quot; +&#xA;&quot;       concat_ws('|', coalesce(profession, ''), coalesce(code_specialite, '')) &quot; +&#xA;&quot;FROM silver.v_j2_professionnel &quot; +&#xA;&quot;WHERE date_ingestion = '&quot; + context.date_lot + &quot;' AND (identifiant IS NULL OR rang &gt; 1) &quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="Rejets silver.rejets"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tHiveRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="1168">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHiveRow_6" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tHiveConnection_1"/>
    <elementParameter field="CLOSED_LIST" name="DISTRIBUTION" value="CLOUDERA"/>
    <elementParameter field="CLOSED_LIST" name="HIVE_VERSION" value="Cloudera_CDH5_13_0"/>
    <elementParameter field="TECHNICAL" name="SCHEMA_FLOW:SCHEMA_TYPE" value="BUILT_IN"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT OVERWRITE TABLE gold.dim_professionnel &quot; +&#xA;&quot;SELECT id, identifiant, categorie_professionnelle, profession, specialite, etablissement_id FROM ( &quot; +&#xA;&quot;  SELECT -1 AS id, 'NR' AS identifiant, 'Non renseigne' AS categorie_professionnelle, 'Non renseigne' AS profession, &quot; +&#xA;&quot;         'Non renseigne' AS specialite, -1 AS etablissement_id &quot; +&#xA;&quot;  FROM gold.dual &quot; +&#xA;&quot;  UNION ALL &quot; +&#xA;&quot;  SELECT CAST(row_number() OVER (ORDER BY p.identifiant) AS INT) AS id, p.identifiant AS identifiant, &quot; +&#xA;&quot;         p.categorie_professionnelle AS categorie_professionnelle, p.profession AS profession, &quot; +&#xA;&quot;         p.specialite AS specialite, coalesce(e.id, -1) AS etablissement_id &quot; +&#xA;&quot;  FROM silver.professionnel p &quot; +&#xA;&quot;  LEFT JOIN gold.dim_etablissement e ON e.code = p.etablissement_code &quot; +&#xA;&quot;) u &quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="Chargement gold.dim_professionnel"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tHiveRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="1280">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHiveRow_7" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tHiveConnection_1"/>
    <elementParameter field="CLOSED_LIST" name="DISTRIBUTION" value="CLOUDERA"/>
    <elementParameter field="CLOSED_LIST" name="HIVE_VERSION" value="Cloudera_CDH5_13_0"/>
    <elementParameter field="TECHNICAL" name="SCHEMA_FLOW:SCHEMA_TYPE" value="BUILT_IN"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT INTO TABLE audit.journal_chargements &quot; +&#xA;&quot;SELECT 'J2_Professionnels', '&quot; + context.date_lot + &quot;', from_unixtime(unix_timestamp()), sum(b), sum(s), sum(r), sum(g), 'OK' &quot; +&#xA;&quot;FROM ( &quot; +&#xA;&quot;  SELECT CAST(n AS BIGINT) AS b, CAST(0 AS BIGINT) AS s, CAST(0 AS BIGINT) AS r, CAST(0 AS BIGINT) AS g FROM (SELECT count(*) AS n FROM bronze.professionnel_de_sante WHERE date_ingestion = '&quot; + context.date_lot + &quot;') b0 &quot; +&#xA;&quot;  UNION ALL &quot; +&#xA;&quot;  SELECT CAST(0 AS BIGINT) AS b, CAST(n AS BIGINT) AS s, CAST(0 AS BIGINT) AS r, CAST(0 AS BIGINT) AS g FROM (SELECT count(*) AS n FROM silver.professionnel) s0 &quot; +&#xA;&quot;  UNION ALL &quot; +&#xA;&quot;  SELECT CAST(0 AS BIGINT) AS b, CAST(0 AS BIGINT) AS s, CAST(n AS BIGINT) AS r, CAST(0 AS BIGINT) AS g FROM (SELECT count(*) AS n FROM silver.rejets WHERE job = 'J2_Professionnels' AND date_lot = '&quot; + context.date_lot + &quot;') r0 &quot; +&#xA;&quot;  UNION ALL &quot; +&#xA;&quot;  SELECT CAST(0 AS BIGINT) AS b, CAST(0 AS BIGINT) AS s, CAST(0 AS BIGINT) AS r, CAST(n AS BIGINT) AS g FROM (SELECT count(*) AS n FROM gold.dim_professionnel) g0 &quot; +&#xA;&quot;) x &quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="Ajout audit.journal_chargements"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>

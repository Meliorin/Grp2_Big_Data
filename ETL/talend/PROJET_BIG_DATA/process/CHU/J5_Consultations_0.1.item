  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="64" posY="48">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_1" show="false"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="// Lot de chargement : date du jour si non renseigne&#xA;if (context.date_lot == null || context.date_lot.trim().isEmpty()) {&#xA;    context.date_lot = TalendDate.formatDate(&quot;yyyy-MM-dd&quot;, TalendDate.getCurrentDate());&#xA;}&#xA;if (context.sel_hash == null || context.sel_hash.trim().length() &lt; 8) {&#xA;    throw new RuntimeException(&quot;context.sel_hash doit etre renseigne (8 caracteres minimum) : pseudonymisation RGPD&quot;);&#xA;}&#xA;System.out.println(&quot;[J5_Consultations] lot &quot; + context.date_lot);"/>
    <elementParameter field="TEXT" name="LABEL" value="Initialisation du lot"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>

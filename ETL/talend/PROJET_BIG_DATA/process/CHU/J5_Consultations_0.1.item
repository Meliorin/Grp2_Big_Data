    <elementParameter field="CLOSED_LIST" name="DISTRIBUTION" value="CLOUDERA"/>
    <elementParameter field="CLOSED_LIST" name="HIVE_VERSION" value="Cloudera_CDH5_13_0"/>
    <elementParameter field="TECHNICAL" name="SCHEMA_FLOW:SCHEMA_TYPE" value="BUILT_IN"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT OVERWRITE TABLE silver.consultation PARTITION (annee) &quot; +&#xA;&quot;SELECT c.num_consultation, sha2(concat('&quot; + context.sel_hash + &quot;', c.id_patient), 256), c.id_prof_sante, c.code_diag, c.motif, &quot; +&#xA;&quot;       c.date_consultation, c.duree_min, pr.etablissement_code, coalesce(pa.sexe, 'I'), &quot; +&#xA;&quot;       year(c.date_consultation) - year(pa.date_naissance), &quot; +&#xA;&quot;       year(c.date_consultation) AS annee &quot; +&#xA;&quot;FROM silver.v_j5_consultation c &quot; +&#xA;&quot;LEFT JOIN silver.patient pa ON pa.id_patient_hash = sha2(concat('&quot; + context.sel_hash + &quot;', c.id_patient), 256) &quot; +&#xA;&quot;LEFT JOIN silver.professionnel pr ON pr.identifiant = c.id_prof_sante &quot; +&#xA;&quot;WHERE c.date_ingestion = '&quot; + context.date_lot + &quot;' AND c.num_consultation IS NOT NULL AND c.date_consultation IS NOT NULL &quot; +&#xA;&quot;  AND c.code_diag IS NOT NULL AND c.duree_min IS NOT NULL AND c.rang = 1 &quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="Chargement silver.consultation"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tHiveRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="608">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHiveRow_3" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tHiveConnection_1"/>
    <elementParameter field="CLOSED_LIST" name="DISTRIBUTION" value="CLOUDERA"/>
    <elementParameter field="CLOSED_LIST" name="HIVE_VERSION" value="Cloudera_CDH5_13_0"/>
    <elementParameter field="TECHNICAL" name="SCHEMA_FLOW:SCHEMA_TYPE" value="BUILT_IN"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT OVERWRITE TABLE silver.rejets PARTITION (job = 'J5_Consultations', date_lot = '&quot; + context.date_lot + &quot;') &quot; +&#xA;&quot;SELECT 'Consultation', coalesce(CAST(num_consultation AS STRING), ''), &quot; +&#xA;&quot;       CASE WHEN num_consultation IS NULL THEN 'numero absent' &quot; +&#xA;&quot;            WHEN date_consultation IS NULL THEN 'date absente ou invalide' &quot; +&#xA;&quot;            WHEN code_diag IS NULL THEN 'code diagnostic absent' &quot; +&#xA;&quot;            WHEN duree_min IS NULL THEN 'heures invalides' &quot; +&#xA;&quot;            ELSE 'doublon num_consultation' END, &quot; +&#xA;&quot;       concat_ws('|', coalesce(date_consultation, ''), coalesce(code_diag, ''), coalesce(id_prof_sante, '')) &quot; +&#xA;&quot;FROM silver.v_j5_consultation &quot; +&#xA;&quot;WHERE date_ingestion = '&quot; + context.date_lot + &quot;' &quot; +&#xA;&quot;  AND (num_consultation IS NULL OR date_consultation IS NULL OR code_diag IS NULL OR duree_min IS NULL OR rang &gt; 1) &quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="Rejets silver.rejets"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tHiveRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="720">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHiveRow_4" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tHiveConnection_1"/>
    <elementParameter field="CLOSED_LIST" name="DISTRIBUTION" value="CLOUDERA"/>
    <elementParameter field="CLOSED_LIST" name="HIVE_VERSION" value="Cloudera_CDH5_13_0"/>
    <elementParameter field="TECHNICAL" name="SCHEMA_FLOW:SCHEMA_TYPE" value="BUILT_IN"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT OVERWRITE TABLE gold.fait_consultation_etablissement PARTITION (annee) &quot; +&#xA;&quot;SELECT coalesce(e.id, -1), CAST(regexp_replace(c.date_consultation, '-', '') AS BIGINT), &quot; +&#xA;&quot;       CAST(count(*) AS INT), sum(c.duree_min), c.annee &quot; +&#xA;&quot;FROM silver.consultation c &quot; +&#xA;&quot;LEFT JOIN gold.dim_etablissement e ON e.code = c.etablissement_code &quot; +&#xA;&quot;GROUP BY coalesce(e.id, -1), c.date_consultation, c.annee &quot; +&#xA;&quot;DISTRIBUTE BY annee &quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="Chargement gold.fait_consultation_etablissement"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tHiveRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="832">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHiveRow_5" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tHiveConnection_1"/>
    <elementParameter field="CLOSED_LIST" name="DISTRIBUTION" value="CLOUDERA"/>
    <elementParameter field="CLOSED_LIST" name="HIVE_VERSION" value="Cloudera_CDH5_13_0"/>
    <elementParameter field="TECHNICAL" name="SCHEMA_FLOW:SCHEMA_TYPE" value="BUILT_IN"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT OVERWRITE TABLE gold.fait_consultation_diagnostic PARTITION (annee) &quot; +&#xA;&quot;SELECT coalesce(d.id, -1), CAST(regexp_replace(c.date_consultation, '-', '') AS BIGINT), &quot; +&#xA;&quot;       CAST(count(*) AS INT), sum(c.duree_min), c.annee &quot; +&#xA;&quot;FROM silver.consultation c &quot; +&#xA;&quot;LEFT JOIN gold.dim_diagnostic d ON d.code = c.code_diag &quot; +&#xA;&quot;GROUP BY coalesce(d.id, -1), c.date_consultation, c.annee &quot; +&#xA;&quot;DISTRIBUTE BY annee &quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="Chargement gold.fait_consultation_diagnostic"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
  <node componentName="tHiveRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="944">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHiveRow_6" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tHiveConnection_1"/>

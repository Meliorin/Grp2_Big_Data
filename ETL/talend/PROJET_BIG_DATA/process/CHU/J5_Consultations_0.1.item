  </node>
  <node componentName="tHiveRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="64" posY="1056">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tHiveRow_7" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="true"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tHiveConnection_1"/>
    <elementParameter field="CLOSED_LIST" name="DISTRIBUTION" value="CLOUDERA"/>
    <elementParameter field="CLOSED_LIST" name="HIVE_VERSION" value="Cloudera_CDH5_13_0"/>
    <elementParameter field="TECHNICAL" name="SCHEMA_FLOW:SCHEMA_TYPE" value="BUILT_IN"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT INTO TABLE audit.journal_chargements &quot; +&#xA;&quot;SELECT 'J5_Consultations', '&quot; + context.date_lot + &quot;', from_unixtime(unix_timestamp()), sum(b), sum(s), sum(r), sum(g), 'OK' &quot; +&#xA;&quot;FROM ( &quot; +&#xA;&quot;  SELECT CAST(n AS BIGINT) AS b, CAST(0 AS BIGINT) AS s, CAST(0 AS BIGINT) AS r, CAST(0 AS BIGINT) AS g FROM (SELECT count(*) AS n FROM bronze.consultation WHERE date_ingestion = '&quot; + context.date_lot + &quot;') b0 &quot; +&#xA;&quot;  UNION ALL &quot; +&#xA;&quot;  SELECT CAST(0 AS BIGINT) AS b, CAST(n AS BIGINT) AS s, CAST(0 AS BIGINT) AS r, CAST(0 AS BIGINT) AS g FROM (SELECT count(*) AS n FROM silver.consultation) s0 &quot; +&#xA;&quot;  UNION ALL &quot; +&#xA;&quot;  SELECT CAST(0 AS BIGINT) AS b, CAST(0 AS BIGINT) AS s, CAST(n AS BIGINT) AS r, CAST(0 AS BIGINT) AS g FROM (SELECT count(*) AS n FROM silver.rejets WHERE job = 'J5_Consultations' AND date_lot = '&quot; + context.date_lot + &quot;') r0 &quot; +&#xA;&quot;  UNION ALL &quot; +&#xA;&quot;  SELECT CAST(0 AS BIGINT) AS b, CAST(0 AS BIGINT) AS s, CAST(0 AS BIGINT) AS r, CAST(n AS BIGINT) AS g FROM (SELECT sum(nombre) AS n FROM gold.fait_consultation_etablissement) g0 &quot; +&#xA;&quot;) x &quot;"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="TEXT" name="LABEL" value="Ajout audit.journal_chargements"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
  </node>
